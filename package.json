{
  "name": "praxis",
  "version": "0.1.155",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/server.mjs --host 127.0.0.1",
    "test": "node scripts/version.mjs check && node --test tests/*.test.mjs",
    "app:demo": "bash scripts/demo-app.sh",
    "apps:dev": "node scripts/local-app.mjs",
    "business": "node src/business/server.mjs",
    "business:admin": "node scripts/business-admin.mjs",
    "gateway": "node scripts/serve-public-praxis.mjs",
    "deploy": "node scripts/deploy.mjs",
    "storage": "node scripts/storage.mjs",
    "logo:generate": "node scripts/generate-logo.mjs",
    "logo:check": "node scripts/generate-logo.mjs --check",
    "test:prd": "node scripts/version.mjs check && node --test tests/prd-catalog.test.mjs tests/prd-renderer.test.mjs tests/workbench-http.test.mjs",
    "test:navigation": "node scripts/version.mjs check && node --test tests/system-navigation.test.mjs tests/app-launcher.test.mjs tests/workbench-http.test.mjs",
    "test:full": "PRAXIS_BUSINESS_DOCKER_TEST=1 PRAXIS_STORAGE_DOCKER_TEST=1 PRAXIS_RESTIC_TEST=1 npm test",
    "stack": "node scripts/stack.mjs",
    "stack:all": "node scripts/run-stack.mjs",
    "business:stack": "node scripts/business-stack.mjs",
    "storage:register": "node scripts/storage-bootstrap.mjs register",
    "app:data": "node scripts/app-data.mjs",
    "data:inventory": "node scripts/data-inventory.mjs publish",
    "storage:worker": "node scripts/storage-worker.mjs",
    "business:sync": "node scripts/business-sync-worker.mjs",
    "observations": "node scripts/observations.mjs",
    "polaris:stack": "node scripts/polaris-stack.mjs",
    "version:patch": "node scripts/version.mjs patch",
    "version:check": "node scripts/version.mjs check",
    "core": "node src/core/server.mjs",
    "core:admin": "node scripts/core-admin.mjs",
    "core:stack": "node scripts/core-stack.mjs",
    "apps:refresh": "node scripts/generate-compose.mjs",
    "ai-native": "node tests/ai-native/cli.mjs",
    "test:ai-native": "node --test tests/ai-native.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "chart.js": "4.6.1",
    "parse5": "8.1.1",
    "zod": "3.25.76"
  },
  "description": "An agent-native workbench for people and the apps behind MCP.",
  "repository": {
    "type": "git",
    "url": "https://github.com/55aaseclab/praxis.git"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.2",
    "@resvg/resvg-js": "2.6.2"
  }
}

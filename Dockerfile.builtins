# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee

# Each target uses its own pinned third_party/<app> directory as build context.
FROM ${NODE_IMAGE} AS base
ARG PRAXIS_UID=1000
ARG PRAXIS_GID=1000
WORKDIR /app
ENV NODE_ENV=production HOST=127.0.0.1
RUN groupmod -o -g "${PRAXIS_GID}" node && usermod -o -u "${PRAXIS_UID}" node \
    && mkdir -p /app /data /data/home && chown -R node:node /app /data /home/node
USER node

FROM base AS reminder
COPY --chown=node:node package.json ./
COPY --chown=node:node src/ ./src/
COPY --chown=node:node public/ ./public/
ENV PORT=4322 REMINDER_DATA=/data/checklist.json
EXPOSE 4322
CMD ["node", "src/server.js"]

FROM base AS knowledge
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-xlrd python3-openpyxl poppler-utils antiword catdoc unrtf ca-certificates \
    && rm -rf /var/lib/apt/lists/*
USER node
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node src/ ./src/
COPY --chown=node:node scripts/ ./scripts/
ENV PORT=14324 KNOWLEDGE_DATA_DIR=/data
EXPOSE 14324
CMD ["node", "src/runtime/server.mjs"]

FROM base AS projects
COPY --chown=node:node package.json ./
COPY --chown=node:node src/ ./src/
COPY --chown=node:node public/ ./public/
ENV PORT=4327 PROJECTS_DATA_DIR=/data
EXPOSE 4327
CMD ["node", "src/server.mjs", "--host", "127.0.0.1", "--port", "4327"]

FROM base AS finance
COPY --chown=node:node package.json ./
COPY --chown=node:node src/ ./src/
COPY --chown=node:node public/ ./public/
ENV PORT=4329 FINANCE_DATA=/data/finance.json
EXPOSE 4329
CMD ["node", "src/server.mjs"]

FROM base AS memo
COPY --chown=node:node package.json index.html sw.js records-client.js ./
COPY --chown=node:node src/ ./src/
COPY --chown=node:node scripts/ ./scripts/
ENV PORT=4325 MEMO_DATA_DIR=/data
EXPOSE 4325
CMD ["node", "src/main.mjs"]

FROM base AS intelligence
COPY --chown=node:node package.json ./
COPY --chown=node:node src/ ./src/
COPY --chown=node:node public/ ./public/
ENV PORT=4330 INTELLIGENCE_PREVIEW=0 INTELLIGENCE_DATA_DIR=/data
EXPOSE 4330
CMD ["node", "src/server.mjs"]

FROM base AS travel
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node src/ ./src/
COPY --chown=node:node scripts/build-trips.js ./scripts/
COPY --chown=node:node data/trips.json data/routes.json data/photo-credits.json ./data/
COPY --chown=node:node public/index.html public/routes.json ./public/
COPY --chown=node:node assets/vendor/material-icons/LICENSE ./assets/vendor/material-icons/
RUN node scripts/build-trips.js
ENV PORT=4323
EXPOSE 4323
CMD ["node", "src/server.js"]

FROM base AS tingproof-build
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node src/ ./src/
COPY --chown=node:node server/ ./server/
COPY --chown=node:node index.html tsconfig.json vite.config.ts vite-plugin-tingproof-api.ts ./
RUN npm run build
RUN node_modules/.bin/vite build --base /apps/tingproof/ --outDir dist-public

FROM base AS tingproof
COPY --from=tingproof-build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=tingproof-build --chown=node:node /app/node_modules/ ./node_modules/
COPY --from=tingproof-build --chown=node:node /app/dist/ ./dist/
COPY --from=tingproof-build --chown=node:node /app/dist-public/ ./dist-public/
COPY --from=tingproof-build --chown=node:node /app/dist-server/ ./dist-server/
ENV PORT=15173 TINGPROOF_DATA_DIR=/data
EXPOSE 15173
CMD ["node", "dist-server/main.js"]

FROM base AS lattice
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium ffmpeg gcc libc6-dev ca-certificates fonts-dejavu-core fonts-liberation fonts-noto-cjk \
    libgomp1 libglib2.0-0 libnss3 libasound2 \
    && rm -rf /var/lib/apt/lists/*
USER node
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node packages/runtime/package.json ./packages/runtime/
COPY --chown=node:node packages/cli/package.json ./packages/cli/
COPY --chown=node:node packages/cli/src/index.js ./packages/cli/src/
RUN ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm ci --include=dev --no-audit --no-fund
COPY --chown=node:node packages/runtime/src/ ./packages/runtime/src/
COPY --chown=node:node packages/runtime/themes/ ./packages/runtime/themes/
COPY --chown=node:node packages/cli/src/ ./packages/cli/src/
COPY --chown=node:node src/ ./src/
COPY --chown=node:node scripts/ ./scripts/
COPY --chown=node:node decks/registry.js ./decks/
COPY --chown=node:node decks/registry.js ./default-decks/
COPY --chown=node:node index.html lattice.config.js vite.config.mjs ./
COPY --from=platform --chown=node:node /scripts/build-slides-public.mjs /scripts/serve-slides-public.mjs /scripts/serve-static-app.mjs /opt/praxis/scripts/
COPY --from=platform --chown=node:node /src/image-cache.mjs /opt/praxis/src/
COPY --from=platform --chown=node:node /packaging/builtins/start-lattice.mjs /packaging/builtins/prune-video-engines.mjs /opt/praxis/scripts/
ENV PRAXIS_LATTICE_ROOT=/app PUBLIC_BASE_PATH=/apps/slides
RUN node /opt/praxis/scripts/build-slides-public.mjs \
    && mkdir -p /data/slides/home /data/slides/cache /app/dist/static-decks /app/.lattice/runtime \
    && mv /app/dist-public-viewer /app/.lattice/runtime/viewer \
    && mv /app/dist-public-workbench /app/.lattice/runtime/workbench \
    && mv /app/dist-public-business /app/.lattice/runtime/business \
    && ln -s /app/.lattice/runtime/viewer /app/dist-public-viewer \
    && ln -s /app/.lattice/runtime/workbench /app/dist-public-workbench \
    && ln -s /app/.lattice/runtime/business /app/dist-public-business \
    && ln -s dist-public-business /app/dist-business
RUN node /opt/praxis/scripts/prune-video-engines.mjs /app
ENV PORT=14666 HOME=/data/slides/home XDG_CACHE_HOME=/data/slides/cache LATTICE_CHROMIUM=/usr/bin/chromium LATTICE_TTS_CACHE=/data/slides/cache/kokoro LATTICE_PIPER_DIR=/data/slides/cache/piper
EXPOSE 14666 4328
CMD ["node", "/opt/praxis/scripts/start-lattice.mjs"]

FROM base AS polaris-build
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node apps/polaris-portal/package.json ./apps/polaris-portal/
COPY --chown=node:node packages/polaris-shell/package.json ./packages/polaris-shell/
COPY --chown=node:node packages/surface-wanghai/package.json ./packages/surface-wanghai/
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node apps/polaris-portal/src/ ./apps/polaris-portal/src/
COPY --chown=node:node apps/polaris-portal/scripts/ ./apps/polaris-portal/scripts/
COPY --chown=node:node apps/polaris-portal/index.html apps/polaris-portal/tsconfig.json apps/polaris-portal/vite.config.ts ./apps/polaris-portal/
COPY --chown=node:node packages/polaris-shell/src/ ./packages/polaris-shell/src/
COPY --chown=node:node packages/polaris-shell/tsconfig.json ./packages/polaris-shell/
COPY --chown=node:node packages/surface-wanghai/src/ ./packages/surface-wanghai/src/
COPY --chown=node:node packages/surface-wanghai/tsconfig.json ./packages/surface-wanghai/
RUN npm run build

FROM base AS polaris
COPY --chown=node:node package.json server.mjs ./
COPY --from=polaris-build --chown=node:node /app/apps/polaris-portal/dist/ ./apps/polaris-portal/dist/
ENV PORT=18787
EXPOSE 18787
CMD ["node", "server.mjs"]

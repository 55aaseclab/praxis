# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
FROM ${NODE_IMAGE} AS tools
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl bzip2 unzip \
    && rm -rf /var/lib/apt/lists/*
# Hashes are pinned from the projects' release SHA256SUMS, not build arguments.
RUN set -eu; case "${TARGETARCH:-amd64}" in \
      amd64) restic_sha=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c; rclone_sha=b00f00b3266c3764413afe599d3ec316f6f43b3e0ea8a0bc1d186d2133e46df7 ;; \
      arm64) restic_sha=a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465; rclone_sha=ee169016675e23a69d77240565133ff7dbc9b33d16fa8f7053d4af39f1eaeb78 ;; \
      *) exit 1 ;; esac; \
    curl --fail --location --retry 3 "https://github.com/restic/restic/releases/download/v0.19.1/restic_0.19.1_linux_${TARGETARCH:-amd64}.bz2" -o /tmp/restic.bz2; \
    printf '%s  %s\n' "$restic_sha" /tmp/restic.bz2 | sha256sum -c -; \
    bzip2 -dc /tmp/restic.bz2 > /usr/local/bin/restic; \
    curl --fail --location --retry 3 "https://github.com/rclone/rclone/releases/download/v1.76.0/rclone-v1.76.0-linux-${TARGETARCH:-amd64}.zip" -o /tmp/rclone.zip; \
    printf '%s  %s\n' "$rclone_sha" /tmp/rclone.zip | sha256sum -c -; \
    unzip -q /tmp/rclone.zip -d /tmp/rclone; \
    cp /tmp/rclone/rclone-v1.76.0-linux-*/rclone /usr/local/bin/rclone; \
    chmod 755 /usr/local/bin/restic /usr/local/bin/rclone

FROM ${NODE_IMAGE}
ARG PRAXIS_UID=1000
ARG PRAXIS_GID=1000
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupmod -o -g "${PRAXIS_GID}" node && usermod -o -u "${PRAXIS_UID}" node \
    && mkdir -p /opt/praxis && chown node:node /opt/praxis
COPY --from=tools /usr/local/bin/restic /usr/local/bin/rclone /usr/local/bin/
WORKDIR /opt/praxis
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node src/storage ./src/storage
COPY --chown=node:node src/business ./src/business
COPY --chown=node:node scripts/storage.mjs scripts/storage-worker.mjs scripts/business-sync-worker.mjs ./scripts/
ENV NODE_ENV=production PRAXIS_RESTIC_BINARY=/usr/local/bin/restic PRAXIS_RCLONE_BINARY=/usr/local/bin/rclone
USER node
CMD ["node", "scripts/storage-worker.mjs", "run"]
